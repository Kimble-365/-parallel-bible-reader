    {
      "id": "hbo-sp",
      "books": 5,
      "verses": 5841,
      "license": "CC BY-NC 4.0",
      "source": "https://github.com/DT-UCPH/sp",
      "method": "Primary TF morphemes rejoined using source trailers. Samaritan Hebrew in Jewish Hebrew glyphs; consonantal source, no invented pointing. Source verse regrouping retained."
    },
    {
      "id": "lat-clementine-thb",
      "books": 39,
      "verses": 23480,
      "license": "Public Domain",
      "source": "https://github.com/evenderekh/THB",
      "method": "39-book OT extract, not the complete Vulgate canon. THB surface tokens joined with spaces, including spaces around punctuation; accent spelling retained; inferred morphology excluded."
    },
    {
      "id": "hbo-mam",
      "books": 39,
      "verses": 23202,
      "license": "CC BY-SA 4.0",
      "source": "https://en.wikisource.org/wiki/User:Dovi/Miqra_according_to_the_Masorah#beginning",
      "method": "Role-aware MAM-simple projection, native MAM verse labels. Ketiv and qere both shown (unpointed / pointed); combined cantillation selected once. Notes and repeated good endings excluded from running text. Exceptional letters retain text; layout separators become spaces; implicit maqaf shown as maqaf. Original structured files in BHH sources retain roles. This is an incomplete extract of MAM, not a diplomatic Masorah edition."
    }
